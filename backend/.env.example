# ─── RENOVA / ECOVAL BACKEND CONFIGURATION ────────────────────────────────

# Database Configuration (SQLite local or Turso cloud)
DATABASE_URL=sqlite:///./ecoval.db
TURSO_AUTH_TOKEN=

# CORS Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000", "https://renova-heritage-breeze-block-hcmut.netlify.app"]

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=info@ecoval.vn
USE_MOCK_EMAIL=True

# Security & Encryption
JWT_SECRET_KEY=renova-admin-secret-key-2026-super-secure
ENCRYPTION_KEY=ULgXQZxIRcrPGGC4gO8he5D8Vor8G08oiWzagVp2948=

# DeepSeek LLM API Configuration
DEEPSEEK_API_KEY=sk-...
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# Embedding Configuration ("huggingface" for free cloud API, "local" for local onnxruntime)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── LANGFUSE LLM OBSERVABILITY & TRACING ────────────────────────────────
# For Langfuse Cloud (EU): LANGFUSE_HOST=https://cloud.langfuse.com
# For Langfuse Cloud (US): LANGFUSE_HOST=https://us.cloud.langfuse.com
# For Local Docker:       LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
ENVIRONMENT=production
